// ============================================================================
//  МОДЕЛЬ ДАННЫХ приложения «Лёгкий старт» (академия Whieda)
// ----------------------------------------------------------------------------
//  Это "чертёж склада": описывает, ЧТО приложение хранит и КАК связано между
//  собой. Каждый блок model = одна таблица (как отдельный лист в Excel).
//  Читается сверху вниз. Комментарии (строки с //) — для человека, программа
//  их не исполняет.
// ============================================================================


// --- Технические настройки (это не данные, а "как хранить"). ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // sqlite — лёгкая база для разработки на компьютере (один файл, без установки).
  // На сервере заменим на "postgresql" — модель данных остаётся той же.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


// ============================================================================
//  ТАБЛИЦА 1: User — УЧЕНИК (главная таблица приложения)
//  Одна строка = один человек в академии.
// ============================================================================

model User {
  id        String   @id @default(cuid()) // уникальный номер ученика (выдаётся сам)

  // --- Кто это (данные приходят с оплаты на GetCourse) ---
  firstName String?                        // имя       (? = может быть пустым)
  lastName  String?                        // фамилия
  email     String?  @unique               // почта — по ней связываем оба входа
  phone     String?  @unique               // телефон — запасной способ связать

  // --- Через какие "двери" вошёл ---
  telegramId String? @unique               // ID в Telegram (если вошёл через бота)
  // Браузерный вход отдельного поля не требует — он привязан к email/phone.

  // --- Роль/уровень в академии ---
  // Допустимые значения: NEWBIE (Новичок), DIRECTOR (Директор),
  //                      NATIONAL (Национальный директор), CURATOR (Куратор).
  role      String   @default("NEWBIE")

  // --- Реферальная связь: КТО ПРИГЛАСИЛ этого ученика ---
  referrerId String?                       // номер пригласившего (пусто у самых первых)
  referrer   User?    @relation("Referrals", fields: [referrerId], references: [id])
  referrals  User[]   @relation("Referrals") // список всех, кого пригласил ОН сам
  // Цепочку "пригласивший пригласившего..." приложение проходит по этим связям
  // на нужную глубину (бонусы считаем на 3 уровня — см. логику Сейлбота).

  // --- Баллы «Драконы» ---
  dragons   Int      @default(0)           // текущий баланс баллов (быстрый счётчик)
  // Детализация "за что начислено" — в таблице DragonTransaction ниже.

  // --- Статус прохождения программы (управляется вебхуками GetCourse) ---
  // Допустимые значения: ACTIVE (идёт), PAUSED (пауза), STOPPED (остановлено).
  programStatus    String    @default("ACTIVE")
  programStartDate DateTime?                    // когда стартовал 10-дневный курс

  // --- Связи с другими таблицами (заполняются автоматически) ---
  dragonHistory     DragonTransaction[]    // все начисления баллов этому ученику
  missionsDone      MissionCompletion[]    // какие миссии он выполнил

  // --- Служебные даты ---
  createdAt DateTime @default(now())        // когда появился в системе
  updatedAt DateTime @updatedAt             // когда последний раз что-то менялось
}


// ============================================================================
//  ТАБЛИЦА 2: DragonTransaction — ЖУРНАЛ НАЧИСЛЕНИЙ «Драконов»
//  Одна строка = одно начисление. Нужен, чтобы видеть ЗА ЧТО дали баллы,
//  а не только итоговую сумму.
// ============================================================================

model DragonTransaction {
  id        String   @id @default(cuid())

  userId    String                          // кому начислено
  user      User     @relation(fields: [userId], references: [id])

  amount    Int                             // сколько баллов (+10, +5, +50, +100...)

  // За что начислено. Допустимые значения:
  //   DAILY_MISSION    +10  итог дня / выполненная миссия
  //   CALL             +5   звонок
  //   DIRECTOR_MEETING +50  встреча с директором
  //   DEAL_CLOSED      +100 закрытая сделка
  //   REFERRAL_BONUS   бонус за активность приглашённого (на 3 уровня вглубь)
  //   OTHER            прочее / ручная корректировка
  reason    String

  createdAt DateTime @default(now())        // когда начислено
}


// ============================================================================
//  ТАБЛИЦА 3: ProgramDay — ДЕНЬ 10-ДНЕВНОЙ ПРОГРАММЫ (справочник)
//  Одна строка = один день курса (День 0 ... День 10). Заполняется один раз.
// ============================================================================

model ProgramDay {
  id          String    @id @default(cuid())
  dayNumber   Int       @unique             // номер дня: 0,1,2,...,10
  title       String                        // тема дня (напр. "Знакомство с продуктом")
  description String?                        // подробное описание/материалы дня

  missions    Mission[]                     // миссии этого дня (см. таблицу 4)
}


// ============================================================================
//  ТАБЛИЦА 4: Mission — МИССИЯ (задание внутри дня программы)
//  Одна строка = одно задание. За выполнение дают «Драконов».
// ============================================================================

model Mission {
  id            String     @id @default(cuid())

  programDayId  String                       // к какому дню относится
  programDay    ProgramDay @relation(fields: [programDayId], references: [id])

  title         String                       // название задания
  description   String?                       // что нужно сделать
  dragonReward  Int        @default(10)       // сколько баллов за выполнение

  completions   MissionCompletion[]           // кто эту миссию выполнил
}


// ============================================================================
//  ТАБЛИЦА 5: MissionCompletion — ОТМЕТКА "миссия выполнена"
//  Одна строка = "ученик X выполнил миссию Y". Связывает учеников и миссии.
// ============================================================================

model MissionCompletion {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  missionId   String
  mission     Mission  @relation(fields: [missionId], references: [id])

  completedAt DateTime @default(now())

  @@unique([userId, missionId]) // одну миссию нельзя "выполнить" дважды
}
