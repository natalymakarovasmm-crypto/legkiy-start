# Файлы и папки, которые НЕ надо хранить в GitHub (мусор и секреты).

# Двигатель и скачанные библиотеки — весят много, ставятся заново одной командой
node_modules/

# Секретные настройки (пароли к базе, ключи Telegram) — НИКОГДА не в общий доступ
.env
.env.local

# Локальная база данных для разработки (у каждого своя, в общий доступ не нужна)
*.db
*.db-journal

# Служебный мусор системы
.DS_Store
Thumbs.db
*.log
